import enigma.event.TextMouseEvent;
import enigma.event.TextMouseListener;
import java.awt.event.KeyEvent;
import java.awt.event.KeyListener;

public class cursor {

    public enigma.console.Console cn;

    public TextMouseListener tmlis;
    public KeyListener klis;

    // ------ Standard variables for mouse and keyboard ------
    public int mousepr;
    public int mousex, mousey;
    public int keypr;
    public int rkey;
    // ----------------------------------------------------

    public cursor(enigma.console.Console console) throws Exception {

        cn = console;

        // ------ Mouse ------
        tmlis = new TextMouseListener() {
            public void mouseClicked(TextMouseEvent arg0) {}

            public void mousePressed(TextMouseEvent arg0) {
                if (mousepr == 0) {
                    mousepr = 1;
                    mousex = arg0.getX();
                    mousey = arg0.getY();
                }
            }

            public void mouseReleased(TextMouseEvent arg0) {}
        };
        cn.getTextWindow().addTextMouseListener(tmlis);

        // ------ Keyboard ------
        klis = new KeyListener() {
            public void keyTyped(KeyEvent e) {}

            public void keyPressed(KeyEvent e) {
                if (keypr == 0) {
                    keypr = 1;
                    rkey = e.getKeyCode();
                }
            }

            public void keyReleased(KeyEvent e) {}
        };
        cn.getTextWindow().addKeyListener(klis);

        // =============================================
        // PLAYER A POSITION - find an empty spot
        // =============================================
        int ax = 5, ay = 5;
        boolean flag = false;

        while (!flag) {
            if (Maze.maze[ay][ax] != ' ') {
                ay++;
                ax++;
            } else {
                flag = true;
            }
        }

        // =============================================
        // PLAYER B POSITION
        // B starts at the same square as A (twins joined)
        // mode = 1 means B moves in same direction as A
        // mode = -1 means B moves in opposite direction
        // =============================================
        int bx = ax;
        int by = ay;
        int mode = 1; // 1 = same direction, -1 = opposite direction

        // Draw A on the screen (B is hidden because they are joined)
        Maze.maze[ay][ax] = 'A';
        cn.getTextWindow().output(ax, ay, 'A');

        // =============================================
        // PUT SOME TEST LASERS ON THE MAP
        // So you can see that picking up works.
        // (Later the Game Input System will do this)
        // =============================================
        Maze.maze[3][3] = '@';
        cn.getTextWindow().output(3, 3, '@');
        Maze.maze[5][10] = '@';
        cn.getTextWindow().output(10, 5, '@');
        Maze.maze[7][15] = '@';
        cn.getTextWindow().output(15, 7, '@');

        // =============================================
        // SCORE DISPLAY AREA (right side of maze)
        // =============================================
        int infoX = 55; // column where info text starts

        // =============================================
        // MAIN GAME LOOP
        // =============================================
        while (true) {

            // -----------------------------------------
            // KEYBOARD INPUT
            // -----------------------------------------
            if (keypr == 1) {

                // --- SPACE KEY: FIRE LASER ---
                if (rkey == KeyEvent.VK_SPACE) {

                    // Fire laser from A to B
                    // Only works if A and B are NOT on the same square
                    if (ax != bx || ay != by) {
                        Lasers.fireLaser(ax, ay, bx, by);
                    }

                } else {

                    // --- ARROW KEYS: MOVE PLAYER ---

                    // Calculate where A wants to go
                    int newAX = ax;
                    int newAY = ay;

                    if (rkey == KeyEvent.VK_LEFT)  newAX--;
                    if (rkey == KeyEvent.VK_RIGHT) newAX++;
                    if (rkey == KeyEvent.VK_UP)    newAY--;
                    if (rkey == KeyEvent.VK_DOWN)  newAY++;

                    // Calculate where B wants to go
                    // mode=1: same direction as A
                    // mode=-1: opposite direction of A
                    int newBX = bx;
                    int newBY = by;

                    if (rkey == KeyEvent.VK_LEFT)  newBX = bx + (-1 * mode);
                    if (rkey == KeyEvent.VK_RIGHT) newBX = bx + (1 * mode);
                    if (rkey == KeyEvent.VK_UP)    newBY = by + (-1 * mode);
                    if (rkey == KeyEvent.VK_DOWN)  newBY = by + (1 * mode);

                    // ---- MOVE A ----
                    // Check: is the new position inside the maze?
                    // Check: is the new position not a wall?
                    if (newAY >= 0 && newAY < Maze.MazeX &&
                            newAX >= 0 && newAX < Maze.maze[0].length) {

                        char cellA = Maze.maze[newAY][newAX];

                        // A can move to empty space, or pick up @ or treasures
                        if (cellA == ' ' || cellA == '@' ||
                                cellA == '1' || cellA == '2' || cellA == '3') {

                            // --- PICK UP PACKED LASER (@) ---
                            if (cellA == '@') {
                                Lasers.collectPacked(newAX, newAY);
                            }

                            // Erase A from old position
                            // If B is at the same spot, show B. Otherwise show empty.
                            if (bx == ax && by == ay) {
                                // B was hidden under A, now B appears
                                Maze.maze[ay][ax] = 'B';
                                cn.getTextWindow().output(ax, ay, 'B');
                            } else {
                                Maze.maze[ay][ax] = ' ';
                                cn.getTextWindow().output(ax, ay, ' ');
                            }

                            // Move A to new position
                            ax = newAX;
                            ay = newAY;

                            // If A lands on B's square, only show A
                            if (ax == bx && ay == by) {
                                Maze.maze[ay][ax] = 'A';
                                cn.getTextWindow().output(ax, ay, 'A');
                            } else {
                                Maze.maze[ay][ax] = 'A';
                                cn.getTextWindow().output(ax, ay, 'A');
                            }
                        }
                    }

                    // ---- MOVE B ----
                    if (newBY >= 0 && newBY < Maze.MazeX &&
                            newBX >= 0 && newBX < Maze.maze[0].length) {

                        char cellB = Maze.maze[newBY][newBX];

                        if (cellB == ' ' || cellB == '@' ||
                                cellB == '1' || cellB == '2' || cellB == '3') {

                            // --- PICK UP PACKED LASER (@) ---
                            if (cellB == '@') {
                                Lasers.collectPacked(newBX, newBY);
                            }

                            // Erase B from old position (only if A is not there)
                            if (!(bx == ax && by == ay)) {
                                Maze.maze[by][bx] = ' ';
                                cn.getTextWindow().output(bx, by, ' ');
                            }

                            // Move B to new position
                            bx = newBX;
                            by = newBY;

                            // If B lands on A's square, only show A
                            if (bx == ax && by == ay) {
                                // A is already displayed, do nothing
                            } else {
                                Maze.maze[by][bx] = 'B';
                                cn.getTextWindow().output(bx, by, 'B');
                            }
                        }
                    }
                }

                keypr = 0;
            }

            // -----------------------------------------
            // LASER UPDATES (runs every time unit)
            // -----------------------------------------

            // Spread the next '+' block (if laser is firing)
            Lasers.updateLaserSpread(cn);

            // Decrease lifetime of all '+' blocks, remove dead ones
            Lasers.updateLifetimes(cn);

            // Check if any robots are next to '+' blocks
            // (You'll use this when you add robots later)
            // int[][] hits = Laser.harmRobots();

            // -----------------------------------------
            // DISPLAY INFO (right side of screen)
            // -----------------------------------------
            String laserInfo = "P.Laser : " + Lasers.packedLaserCount + "   ";
            for (int c = 0; c < laserInfo.length(); c++) {
                cn.getTextWindow().output(infoX + c, 5, laserInfo.charAt(c));
            }

            // -----------------------------------------
            // SLEEP - 50ms = 1 time unit
            // -----------------------------------------
            Thread.sleep(50);
        }
    }
}
